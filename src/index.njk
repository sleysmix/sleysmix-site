---
layout: base.njk
title: Sleysmix Mobile Bartending | Mobile bar service in Greater Houston
description: Mobile bartending for corporate events, nonprofits, weddings and private events across Greater Houston. TABC certified. Book a call to plan your bar.
---
<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1>Mobile bartending for events across {{ site.serviceAreaShort }}</h1>
      <p class="lede">For {{ site.audience | sentenceList | lower }} across {{ site.serviceArea }}.{% if site.tabcCertified %} TABC certified.{% endif %}</p>
      {% include "book-call.njk" %}
    </div>
    <div class="hero-media">
      {% image "hero-bar-0455.jpg", "A smiling bartender in a gold-patterned shirt behind a mobile bar with shakers, jiggers and a fresh drink at an evening outdoor event", "(min-width: 900px) 460px, 100vw", { eager: true, class: "ratio-4-5" } %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>Who we serve</h2>
    <ul class="audience">
      {%- for a in site.audience %}
      <li>{{ a }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap">
    <h2>Packages</h2>
    <p>{{ packages.priceNote }}</p>
    <ul class="teaser">
      {%- for p in packages.packages %}
      <li class="card">
        <h3>{{ p.name }}</h3>
        <p class="price"><span class="price-label">Starting at</span> {{ p.startingPrice | usd }}</p>
      </li>
      {%- endfor %}
    </ul>
    <p><a class="text-link" href="/services/">See what each package includes</a></p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>Kind words</h2>
    <figure class="testimonial">
      <blockquote>
        <p>Sleysmix was fantastic to work with. He dedicated time to customize my menu ahead of my event (and I changed my mind quite a few times); was on location ahead of scheduled time to make sure I had everything he needed and to make sure setup was to my satisfaction; the drinks were fantastic - it felt like he catered to each individual guest and the whole time had a pleasant disposition to everyone!</p>
        <p>I HIGHLY recommend his service and will most certainly use him for all events going forward. 10/10 - no hesitation!</p>
      </blockquote>
      <figcaption>zeina roz, Google review</figcaption>
    </figure>
    <figure class="testimonial">
      <blockquote>
        <p>Awesome experience, delicious Mocktail for our Breast Cancer and Domestic Violence event. Thank you so much</p>
      </blockquote>
      <figcaption>Tilla B, Google review</figcaption>
    </figure>
  </div>
</section>

<section class="section section-alt cta-band">
  <div class="wrap">
    <h2>Planning an event?</h2>
    <p>Every event starts with a conversation, so the drink menu fits your guests and your occasion.</p>
    <p class="cta-row">{% include "book-call.njk" %} <a class="text-link" href="/contact/">Or send an inquiry</a></p>
  </div>
</section>
