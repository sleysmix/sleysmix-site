---
layout: base.njk
title: Services & Packages | Sleysmix Mobile Bartending
description: Sleysmix mobile bartending packages with starting prices, add-ons and fees. Final price by quote after a call.
permalink: /services/
---
<section class="section page-head">
  <div class="wrap">
    <h1>Services &amp; Packages</h1>
    <p class="lede">{{ packages.priceNote }}</p>
  </div>
</section>

<section class="section section-tight">
  <div class="wrap">
    <h2 class="visually-hidden">Packages</h2>
    <ul class="packages">
      {%- for p in packages.packages %}
      <li class="card package">
        <h3>{{ p.name }}</h3>
        <p class="price"><span class="price-label">Starting at</span> {{ p.startingPrice | usd }}</p>
        <ul class="checklist">
          {%- for f in p.features %}
          <li>{{ f }}</li>
          {%- endfor %}
        </ul>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap split">
    <div>
      <h2>Custom menus</h2>
      <p>Signature cocktail menus are built for your event and shown at the bar.</p>
    </div>
    <figure class="figure">
      {% image "menu-0450.jpg", "A mobile bar set up in a backyard with a marquee BAR sign, shakers and a framed menu titled Cheers to 50 Years", "(min-width: 900px) 540px, 100vw", { class: "ratio-4-3" } %}
      <figcaption>A custom "Cheers to 50 Years" event menu.</figcaption>
    </figure>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>Add-ons and fees</h2>
    <dl class="addons">
      {%- for a in packages.addOns %}
      <div>
        <dt>{{ a.name }}</dt>
        <dd>{% if a.startingPrice %}Starting at {{ a.startingPrice | usd }}{% elif a.byQuote %}Priced by quote{% endif %}{% if a.note %}{% if a.startingPrice or a.byQuote %}. {% endif %}{{ a.note }}{% endif %}</dd>
      </div>
      {%- endfor %}
    </dl>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap">
    <h2>Good to know</h2>
    <ul class="facts">
      <li>{{ site.clientProvides }}</li>
      {% if site.tabcCertified %}<li>TABC certified.</li>{% endif %}
      <li>Service area: {{ site.serviceArea }}.</li>
    </ul>
    <p class="cta-row">{% include "book-call.njk" %}</p>
  </div>
</section>
